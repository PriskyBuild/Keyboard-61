# Piano Learning App — Environment Variables
# This app is fully client-side; no env vars are required for Vercel deploy.
# Copy this file to `.env.local` if you want to override defaults during local dev.

# Public piano samples CDN (Salamander). CORS-enabled, no key required.
NEXT_PUBLIC_PIANO_SAMPLES_BASE_URL=https://tonejs.github.io/audio/salamander/

# Optional: override the fallback synth type. Values: "polysynth" | "fmsynth"
# NEXT_PUBLIC_FALLBACK_SYNTH=polysynth
